{
  "openapi": "3.0.0",
  "components": {
    "examples": {},
    "headers": {},
    "parameters": {},
    "requestBodies": {},
    "responses": {},
    "schemas": {
      "State": {
        "type": "string",
        "enum": [
          "UNCONFIGURED",
          "HEALTHY",
          "WIPE_IMMINENT",
          "APP_TOKEN_EXPIRED"
        ]
      },
      "StatusResponse": {
        "description": "The wire format. Dates are RFC 3339 as Go formats it; a member with nothing to say is absent, not empty.",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "agentSymbol": {
            "type": "string"
          },
          "resetDate": {
            "type": "string"
          },
          "nextPredictedReset": {
            "type": "string"
          }
        },
        "required": [
          "state"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "MintedToken": {
        "properties": {
          "token": {
            "type": "string"
          },
          "expires_at": {
            "type": "integer",
            "format": "int64",
            "description": "The token's own `exp`, in whole seconds: read from it, never computed."
          }
        },
        "required": [
          "token",
          "expires_at"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "M2MError": {
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "IntrospectionAnswer": {
        "anyOf": [
          {
            "properties": {
              "active": {
                "type": "boolean",
                "enum": [
                  false
                ],
                "nullable": false
              }
            },
            "required": [
              "active"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "operator",
                  "machine"
                ]
              },
              "exp": {
                "type": "number",
                "format": "double"
              },
              "scope": {
                "type": "string"
              },
              "sub": {
                "type": "string"
              },
              "active": {
                "type": "boolean",
                "enum": [
                  true
                ],
                "nullable": false
              }
            },
            "required": [
              "kind",
              "exp",
              "scope",
              "sub",
              "active"
            ],
            "type": "object"
          }
        ]
      },
      "IntrospectionRefusal": {
        "description": "What a refused caller gets.",
        "properties": {
          "error": {
            "properties": {
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "nullable": false
          }
        },
        "required": [
          "status"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    "securitySchemes": {}
  },
  "info": {
    "title": "Auth Service API",
    "version": "0.0.0",
    "description": "The SpaceTraders game credential and the fleet's token verifier. Public routes only: the internal /auth/v1/* routes are documented as they are ported.",
    "contact": {}
  },
  "paths": {
    "/auth/v1/status": {
      "get": {
        "operationId": "Status",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        },
        "description": "UNCONFIGURED, HEALTHY, WIPE_IMMINENT or APP_TOKEN_EXPIRED, with the agent symbol and the dates when known.",
        "tags": [
          "status"
        ],
        "security": [],
        "parameters": []
      }
    },
    "/api/auth/v1/status": {
      "get": {
        "operationId": "ApiStatus",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        },
        "description": "The same answer on the production path prefix.",
        "tags": [
          "status"
        ],
        "security": [],
        "parameters": []
      }
    },
    "/auth/v1/m2m-token": {
      "post": {
        "operationId": "Mint",
        "responses": {
          "200": {
            "description": "The token and its `exp` as `expires_at`",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/MintedToken"
                    },
                    {
                      "$ref": "#/components/schemas/M2MError"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "unknown caller",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/M2MError"
                }
              }
            }
          },
          "503": {
            "description": "the token could not be minted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/M2MError"
                }
              }
            }
          }
        },
        "description": "A Clerk M2M JWT for the calling service, whose `sub` names its Machine and whose `scope` is fixed by auth-service's\ncaller table (`automation-service`: `fleet:control`; `ai-service`: `events:write planner:advise`). The caller is\nidentified by its secret alone and requests nothing: no body, query or other header is read. The token is cached\nand served again until half its lifetime has passed. Never cacheable.",
        "tags": [
          "machine tokens"
        ],
        "security": [],
        "parameters": [
          {
            "description": "The caller's own secret (M2M_CALLER_SECRET_<caller>). The first of repeated headers counts.",
            "in": "header",
            "name": "X-M2M-Caller-Secret",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/auth/v1/introspect": {
      "post": {
        "operationId": "Introspect",
        "responses": {
          "200": {
            "description": "The verdict: `{active:false}`, or `{active:true, sub, scope, exp, kind}` and nothing else",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/IntrospectionAnswer"
                    },
                    {
                      "$ref": "#/components/schemas/IntrospectionRefusal"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "a valid introspection secret is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntrospectionRefusal"
                }
              }
            }
          }
        },
        "description": "Verifies a Clerk JWT and says what it carries (RFC 7662). The request body is `application/x-www-form-urlencoded`\nwith `token=<jwt>`, at most 8 KiB, read by this handler with Go's rules; a token in the query string is never\nread. The answer is `{\"active\":false}` for anything that does not verify, with no reason, and is never cacheable.\n`scope` is the token's claim verbatim (an array claim joined with single spaces), `\"\"` when it carries none; `kind`\nis `operator` when `sub` starts `user_`, otherwise `machine`.",
        "tags": [
          "introspection"
        ],
        "security": [],
        "parameters": [
          {
            "description": "The shared introspection secret (AUTH_INTROSPECTION_SECRET). The first of repeated headers counts.",
            "in": "header",
            "name": "X-Introspection-Secret",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "Health",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        },
        "description": "Liveness check.",
        "tags": [
          "operational"
        ],
        "security": [],
        "parameters": []
      }
    },
    "/api/auth/health": {
      "get": {
        "operationId": "ApiHealth",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        },
        "description": "Liveness check on the production path prefix.",
        "tags": [
          "operational"
        ],
        "security": [],
        "parameters": []
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ]
}
