{
  "openapi": "3.0.0",
  "components": {
    "examples": {},
    "headers": {},
    "parameters": {},
    "requestBodies": {},
    "responses": {},
    "schemas": {
      "AgentToken": {
        "description": "The game credential, for st-gateway alone.",
        "properties": {
          "agentToken": {
            "type": "string"
          }
        },
        "required": [
          "agentToken"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "VaultRefusal": {
        "description": "The `{\"error\":{\"message\":…}}` envelope of a refused caller.",
        "properties": {
          "error": {
            "properties": {
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "State": {
        "type": "string",
        "enum": [
          "UNCONFIGURED",
          "HEALTHY",
          "WIPE_IMMINENT",
          "APP_TOKEN_EXPIRED"
        ]
      },
      "StatusResponse": {
        "description": "The wire format. Dates are RFC 3339 as Go formats it; a member with nothing to say is absent, not empty.",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "agentSymbol": {
            "type": "string"
          },
          "resetDate": {
            "type": "string"
          },
          "nextPredictedReset": {
            "type": "string"
          }
        },
        "required": [
          "state"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "Restored": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "restored"
            ],
            "nullable": false
          }
        },
        "required": [
          "status"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "SessionRefusal": {
        "description": "The `{\"error\":{\"message\":…}}` envelope of a refused session.",
        "properties": {
          "error": {
            "properties": {
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "RestoreTokenRequest": {
        "description": "Restore Token's body, decoded as Go's encoding/json would: key case ignored, unknown keys ignored.",
        "properties": {
          "agentToken": {
            "type": "string",
            "description": "The regenerated agent token, stored verbatim."
          }
        },
        "required": [
          "agentToken"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "Registered": {
        "properties": {
          "agentSymbol": {
            "type": "string",
            "description": "The symbol SpaceTraders answered, not necessarily the one asked for."
          },
          "status": {
            "type": "string",
            "enum": [
              "registered"
            ],
            "nullable": false
          }
        },
        "required": [
          "agentSymbol",
          "status"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "RegisterRequest": {
        "description": "Reset Agent's body, decoded the same way.",
        "properties": {
          "accountToken": {
            "type": "string",
            "description": "The SpaceTraders account token: stored, never answered, never logged."
          },
          "symbol": {
            "type": "string"
          },
          "faction": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "description": "Reserves the call sign across a reset; left out upstream when empty."
          }
        },
        "required": [
          "accountToken",
          "symbol",
          "faction"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "MintedToken": {
        "properties": {
          "token": {
            "type": "string"
          },
          "expires_at": {
            "type": "integer",
            "format": "int64",
            "description": "The token's own `exp`, in whole seconds: read from it, never computed."
          }
        },
        "required": [
          "token",
          "expires_at"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "M2MError": {
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "IntrospectionAnswer": {
        "anyOf": [
          {
            "properties": {
              "active": {
                "type": "boolean",
                "enum": [
                  false
                ],
                "nullable": false
              }
            },
            "required": [
              "active"
            ],
            "type": "object"
          },
          {
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "operator",
                  "machine"
                ]
              },
              "exp": {
                "type": "number",
                "format": "double"
              },
              "scope": {
                "type": "string"
              },
              "sub": {
                "type": "string"
              },
              "active": {
                "type": "boolean",
                "enum": [
                  true
                ],
                "nullable": false
              }
            },
            "required": [
              "kind",
              "exp",
              "scope",
              "sub",
              "active"
            ],
            "type": "object"
          }
        ]
      },
      "IntrospectionRefusal": {
        "description": "What a refused caller gets.",
        "properties": {
          "error": {
            "properties": {
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "nullable": false
          }
        },
        "required": [
          "status"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    "securitySchemes": {}
  },
  "info": {
    "title": "Auth Service API",
    "version": "0.0.0",
    "description": "The SpaceTraders game credential and the fleet's token verifier. Public /api/auth/v1/* routes and the internal /auth/v1/* routes the other services call.",
    "contact": {}
  },
  "paths": {
    "/auth/v1/token": {
      "get": {
        "operationId": "Token",
        "responses": {
          "200": {
            "description": "The agent token",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AgentToken"
                    },
                    {
                      "$ref": "#/components/schemas/VaultRefusal"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "invalid or missing shared secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VaultRefusal"
                }
              }
            }
          },
          "503": {
            "description": "no agent token configured (text/plain)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "description": "The agent token st-gateway injects on every upstream call. Gated by the shared secret, compared in constant time;\na secret in the query string is never read. With `afterUnauthorized=true` (exactly) a forced poll of SpaceTraders\nruns before the answer, at most once per 10 s process-wide, and may replace the token (a wipe re-registers).\n`503` text `no agent token configured` while nothing is stored or the stored token is empty. The token answer has\nno `Cache-Control`, as Go's had none: decision 23 allows `no-store` here, but 15 cases of the contract suite pin\nthe header's absence on this answer (only one accepts either), and contract/ is never edited by a port.",
        "tags": [
          "vault"
        ],
        "security": [],
        "parameters": [
          {
            "description": "AUTH_SERVICE_SHARED_SECRET. The first of repeated headers counts.",
            "in": "header",
            "name": "X-Auth-Service-Secret",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "`true` when st-gateway just saw SpaceTraders answer 401.",
            "in": "query",
            "name": "afterUnauthorized",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/auth/v1/status": {
      "get": {
        "operationId": "Status",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        },
        "description": "UNCONFIGURED, HEALTHY, WIPE_IMMINENT or APP_TOKEN_EXPIRED, with the agent symbol and the dates when known.",
        "tags": [
          "status"
        ],
        "security": [],
        "parameters": []
      }
    },
    "/api/auth/v1/status": {
      "get": {
        "operationId": "ApiStatus",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        },
        "description": "The same answer on the production path prefix.",
        "tags": [
          "status"
        ],
        "security": [],
        "parameters": []
      }
    },
    "/api/auth/v1/agent-token": {
      "post": {
        "operationId": "Restore",
        "responses": {
          "200": {
            "description": "Restored",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Restored"
                    },
                    {
                      "$ref": "#/components/schemas/SessionRefusal"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "agentToken is required, or invalid request body: … (text/plain)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "a bearer token is required / invalid or expired session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionRefusal"
                }
              }
            }
          },
          "403": {
            "description": "this action requires a scope this session does not carry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionRefusal"
                }
              }
            }
          },
          "409": {
            "description": "no credential configured to restore a token onto (text/plain)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "description": "Restore Token (decision 8): replaces only the agent token of the agent already registered and clears\nAPP_TOKEN_EXPIRED. No upstream call. `409` (text) when nothing is registered, `400` (text) for a missing token or\na body that does not decode.",
        "tags": [
          "operator"
        ],
        "security": [],
        "parameters": [
          {
            "description": "`Bearer <Clerk session JWT>` carrying `agent:reset`. The first of repeated headers counts.",
            "in": "header",
            "name": "Authorization",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestoreTokenRequest"
              }
            }
          }
        }
      }
    },
    "/api/auth/v1/register": {
      "post": {
        "operationId": "Register",
        "responses": {
          "200": {
            "description": "Registered",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Registered"
                    },
                    {
                      "$ref": "#/components/schemas/SessionRefusal"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "accountToken, symbol and faction are required, or invalid request body: … (text/plain)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "a bearer token is required / invalid or expired session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionRefusal"
                }
              }
            }
          },
          "403": {
            "description": "this action requires a scope this session does not carry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionRefusal"
                }
              }
            }
          },
          "502": {
            "description": "SpaceTraders could not be reached or answered something unusable (text/plain)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "description": "Reset Agent (decision 7): registers with SpaceTraders through st-gateway (`POST /proxy/register`, the account\ntoken as the bearer), replaces the stored credential wholesale, then polls the root once for the dates. An\nupstream 4xx/5xx is passed through as text `POST /register: <upstream body>`; a transport failure or an unusable\n2xx is `502`.",
        "tags": [
          "operator"
        ],
        "security": [],
        "parameters": [
          {
            "description": "`Bearer <Clerk session JWT>` carrying `agent:reset`. The first of repeated headers counts.",
            "in": "header",
            "name": "Authorization",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        }
      }
    },
    "/auth/v1/m2m-token": {
      "post": {
        "operationId": "Mint",
        "responses": {
          "200": {
            "description": "The token and its `exp` as `expires_at`",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/MintedToken"
                    },
                    {
                      "$ref": "#/components/schemas/M2MError"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "unknown caller",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/M2MError"
                }
              }
            }
          },
          "503": {
            "description": "the token could not be minted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/M2MError"
                }
              }
            }
          }
        },
        "description": "A Clerk M2M JWT for the calling service, whose `sub` names its Machine and whose `scope` is fixed by auth-service's\ncaller table (`automation-service`: `fleet:control`; `ai-service`: `events:write planner:advise`). The caller is\nidentified by its secret alone and requests nothing: no body, query or other header is read. The token is cached\nand served again until half its lifetime has passed. Never cacheable.",
        "tags": [
          "machine tokens"
        ],
        "security": [],
        "parameters": [
          {
            "description": "The caller's own secret (M2M_CALLER_SECRET_<caller>). The first of repeated headers counts.",
            "in": "header",
            "name": "X-M2M-Caller-Secret",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/auth/v1/introspect": {
      "post": {
        "operationId": "Introspect",
        "responses": {
          "200": {
            "description": "The verdict: `{active:false}`, or `{active:true, sub, scope, exp, kind}` and nothing else",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/IntrospectionAnswer"
                    },
                    {
                      "$ref": "#/components/schemas/IntrospectionRefusal"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "a valid introspection secret is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntrospectionRefusal"
                }
              }
            }
          }
        },
        "description": "Verifies a Clerk JWT and says what it carries (RFC 7662). The request body is `application/x-www-form-urlencoded`\nwith `token=<jwt>`, at most 8 KiB, read by this handler with Go's rules; a token in the query string is never\nread. The answer is `{\"active\":false}` for anything that does not verify, with no reason, and is never cacheable.\n`scope` is the token's claim verbatim (an array claim joined with single spaces), `\"\"` when it carries none; `kind`\nis `operator` when `sub` starts `user_`, otherwise `machine`.",
        "tags": [
          "introspection"
        ],
        "security": [],
        "parameters": [
          {
            "description": "The shared introspection secret (AUTH_INTROSPECTION_SECRET). The first of repeated headers counts.",
            "in": "header",
            "name": "X-Introspection-Secret",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "Health",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        },
        "description": "Liveness check.",
        "tags": [
          "operational"
        ],
        "security": [],
        "parameters": []
      }
    },
    "/api/auth/health": {
      "get": {
        "operationId": "ApiHealth",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        },
        "description": "Liveness check on the production path prefix.",
        "tags": [
          "operational"
        ],
        "security": [],
        "parameters": []
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ]
}
